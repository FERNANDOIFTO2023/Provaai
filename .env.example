APP_NAME=Provaai
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
DB_CONNECTION=sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
CACHE_STORE=database
MAIL_MAILER=log
MAIL_FROM_ADDRESS=provaai@example.com
MAIL_FROM_NAME=Provaai
# Produção: configurar SMTP real, HTTPS e APP_DEBUG=false.
# PostgreSQL (inclusive Supabase): DB_CONNECTION=pgsql, DB_HOST, DB_PORT,
# DB_DATABASE, DB_USERNAME, DB_PASSWORD e DB_SSLMODE=require.
# No Supabase, use DB_SCHEMA=provaai em schema privado fora da Data API.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
NODE_BINARY=node

# Use em conjunto para apontar a cópia para outro projeto.
# Sem estas duas variáveis, o site usa a configuração pública da Provaai.
# NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=
# MISTRAL_API_KEY=
# MISTRAL_MODEL=

# Configure GROQ_API_KEY em Supabase > Edge Functions > Secrets.
# A reserva usa openai/gpt-oss-120b; não coloque a chave em NEXT_PUBLIC_*.
